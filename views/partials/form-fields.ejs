<% if (errors && errors.length) { %>
  <ul class="alert alert-error" role="alert">
    <% errors.forEach(function (error) { %><li><%= error %></li><% }); %>
  </ul>
<% } %>

<div class="field">
  <label for="title">Title</label>
  <input type="text" id="title" name="title"
         value="<%= post.title %>"
         placeholder="Give your post a title"
         maxlength="255" required />
</div>

<div class="field">
  <label for="category">Category</label>
  <select id="category" name="category" required>
    <option value="" disabled <%= post.category ? '' : 'selected' %>>Choose a category…</option>
    <% categories.forEach(function (cat) { %>
      <option value="<%= cat %>" <%= post.category === cat ? 'selected' : '' %>>
        <%= cat %>
      </option>
    <% }); %>
  </select>
</div>

<div class="field">
  <label for="body">Content</label>
  <textarea id="body" name="body" rows="10"
            placeholder="Write something worth reading…" required><%= post.body %></textarea>
</div>